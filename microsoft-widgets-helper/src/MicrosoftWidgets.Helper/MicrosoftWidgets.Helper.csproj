<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/helper.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlannerEdge.Helper</RootNamespace>
    <Version>0.1.4</Version>
    <ReleaseVersion>0.3.3</ReleaseVersion>
    <OutputType>WinExe</OutputType>
    <Product>Microsoft Widgets Helper</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/helper.ico" LogicalName="MicrosoftWidgets.Helper.Icon.ico" />
    <EmbeddedResource Include="Assets/helper-light.ico" LogicalName="MicrosoftWidgets.Helper.IconLight.ico" />
    <AssemblyMetadata Include="ReleaseVersion" Value="$(ReleaseVersion)" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.89.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\outlook-edge-widget\dist\**\*" Link="wwwroot\outlook\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\planner-edge-widget\widget\board.html" Link="wwwroot\board\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\planner-edge-widget\widget\styles.css" Link="wwwroot\board\styles.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\planner-edge-widget\widget\src\*.js" Link="wwwroot\board\src\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\planner-edge-widget\widget\resources\*.svg" Link="wwwroot\board\resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireOutlookBundle" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('..\..\..\outlook-edge-widget\dist\index.html')" Text="Build the Outlook widget first: npm ci and npm run build in outlook-edge-widget." />
  </Target>

</Project>
